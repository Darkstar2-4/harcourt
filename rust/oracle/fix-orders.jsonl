# More orders cases, from the fixer. Run with --warm --rust-session, and once more without --rust-session (staff and
# shoppers signed in by company address). Synthetic personas and made-up values only; the record ids are row numbers.
{"name": "cart-ajax-anonymous", "method": "POST", "path": "/cart.php", "persona": "anonymous", "body": "json_code=eA&json_quantity=1", "headers": {"X-Requested-With": "XMLHttpRequest"}}
{"name": "cart-ajax-invalid-code", "method": "POST", "path": "/cart.php", "persona": "customer-active", "body": "json_code=eA&json_quantity=1", "headers": {"X-Requested-With": "XMLHttpRequest"}}
{"name": "cart-ajax-remove-unknown", "method": "POST", "path": "/cart.php", "persona": "customer-active", "body": "json_code=YwlOTy1TVUNILVNLVQ&json_quantity=0", "headers": {"X-Requested-With": "XMLHttpRequest"}}
{"name": "cart-ajax-get", "path": "/cart.php?json_code=eA&json_quantity=2", "persona": "customer-active", "headers": {"X-Requested-With": "XMLHttpRequest"}}
{"name": "checkout-post-anonymous", "method": "POST", "path": "/checkout.php", "persona": "anonymous", "body": "action=complete"}
{"name": "checkout-post-denied", "method": "POST", "path": "/checkout.php", "persona": "customer-denied", "body": "action=complete"}
{"name": "contact-internal", "path": "/contact.php", "persona": "internal-active"}
# A visit's first request, carrying what a browser sends from a page: PHP sent it to the landing page all the same.
{"name": "first-visit-with-referer-cart", "path": "/cart.php?scscpq_wp=1", "persona": "customer-active", "session": "cold", "headers": {"Referer": "https://www.harcourt.co/cart/"}}
{"name": "first-visit-cart-ajax", "method": "POST", "path": "/cart.php", "persona": "customer-active", "session": "cold", "body": "json_code=eA&json_quantity=1", "headers": {"X-Requested-With": "XMLHttpRequest"}}
# A visit that arrives from a campaign link is never sent to the landing page.
{"name": "campaign-visit-cart", "path": "/cart.php?campaign=KIT", "persona": "customer-active", "session": "cold"}
{"name": "campaign-visit-contact", "path": "/contact.php?campaign=KIT", "persona": "anonymous", "session": "cold"}
