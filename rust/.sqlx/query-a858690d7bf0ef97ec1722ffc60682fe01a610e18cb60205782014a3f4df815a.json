  "query": "SELECT s.id AS \"id!: i64\", c.name AS category, s.name, s.leadtime_option, s.leadtime_text, s.status, s.prj, COALESCE(s.sort_order, 0) AS \"sort_order!: i64\"\n           FROM subcategory s LEFT JOIN category c ON c.id = s.category_id\n           WHERE c.id <> 0 AND (?1 = 0 OR s.category_id = ?1) ORDER BY s.id",
