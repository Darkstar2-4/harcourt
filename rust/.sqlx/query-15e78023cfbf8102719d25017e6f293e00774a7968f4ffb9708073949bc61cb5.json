  "query": "SELECT code AS \"code!: String\", COALESCE(name, '') AS \"name!: String\", COALESCE(plural, '') AS \"plural!: String\",\n                  exchange_rate AS \"exchange_rate!: f64\", COALESCE(adder_pct, 0) AS \"adder_pct!: f64\", COALESCE(update_timestamp, 0) AS \"updated!: i64\"\n           FROM currency WHERE exchange_rate > 0 AND active = 1 ORDER BY code <> 'USD', name COLLATE NOCASE",
