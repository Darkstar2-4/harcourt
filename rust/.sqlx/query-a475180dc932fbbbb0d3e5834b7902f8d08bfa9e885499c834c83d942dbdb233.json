  "query": "SELECT id AS \"id!: i64\", COALESCE(parent_id, 0) AS \"parent_id!: i64\", COALESCE(name, '') AS \"name!: String\",\n                  COALESCE(description, '') AS \"description!: String\", COALESCE(active, 0) AS \"active!: i64\"\n           FROM document ORDER BY (CASE WHEN parent_id = 0 THEN '0' || name ELSE '1' || name END) COLLATE NOCASE, id",
