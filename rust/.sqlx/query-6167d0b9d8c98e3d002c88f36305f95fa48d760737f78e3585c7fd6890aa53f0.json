  "query": "SELECT i.sku AS \"sku!\", c.name AS category_name, s.name AS subcategory_name, i.category_id, i.subcategory_id\n               FROM inventory i LEFT JOIN subcategory s ON s.id = i.subcategory_id LEFT JOIN category c ON c.id = i.category_id\n               WHERE i.sku LIKE ?1 AND i.active = 1 ORDER BY i.sku LIMIT ?2",
